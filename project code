Photochemical Smog Formation — 60-second educational animation
Run: python smog_animation.py
Output: photochemical_smog_formation.mp4

Requirements: matplotlib, numpy, imageio-ffmpeg
The chemistry is a simplified teaching mechanism, not a quantitative atmospheric model.
"""
import os
import math
import random
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle, Circle, Polygon, FancyBboxPatch, FancyArrowPatch
from matplotlib.animation import FuncAnimation, FFMpegWriter
import imageio_ffmpeg

# Make Matplotlib use the FFmpeg binary bundled by imageio-ffmpeg.
matplotlib.rcParams["animation.ffmpeg_path"] = imageio_ffmpeg.get_ffmpeg_exe()

FPS = 24
DURATION = 60
TOTAL_FRAMES = FPS * DURATION
OUTFILE = "photochemical_smog_formation.mp4"
random.seed(7)
np.random.seed(7)

# Palette
SKY_DAY = "#86C9E8"
SKY_HAZE = "#B9B6A6"
NAVY = "#102437"
INK = "#102536"
WHITE = "#F7FAFC"
ORANGE = "#F6A23A"
RED = "#E85D4A"
BLUE = "#4A9BD6"
GREEN = "#50B88A"
PURPLE = "#A68BE0"
YELLOW = "#FFD166"
GREY = "#687985"

fig = plt.figure(figsize=(12.8, 7.2), dpi=100, facecolor=NAVY)
ax = fig.add_axes([0, 0, 1, 1])
ax.set_xlim(0, 16)
ax.set_ylim(0, 9)
ax.axis("off")

# Background layers
sky = Rectangle((0, 0), 16, 9, color=SKY_DAY, zorder=0)
ax.add_patch(sky)
# Soft horizon
ax.add_patch(Rectangle((0, 0), 16, 2.1, color="#D8E4D8", zorder=1))
# Distant hills
ax.add_patch(Polygon([(0,2.1),(2,2.9),(4,2.2),(6.5,3.0),(9,2.1),(12,2.8),(16,2.0),(16,0),(0,0)],
                     closed=True, color="#91B8A5", alpha=.55, zorder=1))

# Sun
sun = Circle((13.8, 7.45), .52, color=YELLOW, ec="#FFF1B3", lw=2, zorder=3)
ax.add_patch(sun)
sun_rays=[]
for ang in np.linspace(0,2*np.pi,12,endpoint=False):
    x1,y1=13.8+0.68*np.cos(ang),7.45+0.68*np.sin(ang)
    x2,y2=13.8+0.9*np.cos(ang),7.45+0.9*np.sin(ang)
    ray,=ax.plot([x1,x2],[y1,y2], color="#FFF0A6", lw=2, alpha=.85,zorder=2)
    sun_rays.append(ray)

# City skyline (vector shapes)
buildings = [
    (0.35,1.3,1.0,2.1,"#657F8E"), (1.45,1.3,.9,3.0,"#526D7D"),
    (2.45,1.3,1.15,1.8,"#718B97"), (3.72,1.3,.8,2.5,"#526B7A"),
    (4.62,1.3,1.2,1.7,"#718B97"), (5.95,1.3,.95,2.7,"#526D7D"),
    (7.0,1.3,1.15,1.9,"#718B97"), (8.25,1.3,.9,2.4,"#526D7D"),
    (9.25,1.3,1.15,1.7,"#718B97"), (10.5,1.3,1.0,2.8,"#526D7D"),
    (11.6,1.3,1.2,2.0,"#718B97"), (12.9,1.3,.9,2.5,"#526D7D"),
    (13.9,1.3,1.35,1.8,"#718B97"), (15.3,1.3,.5,2.4,"#526D7D")
]
for x,y,w,h,c in buildings:
    ax.add_patch(Rectangle((x,y),w,h,color=c,zorder=3,ec="#425B68",lw=.5))
    # windows
    for wx in np.arange(x+.16,x+w-.08,.25):
        for wy in np.arange(y+.22,y+h-.1,.32):
            ax.add_patch(Rectangle((wx,wy),.09,.12,color="#E9DCA7",alpha=.8,zorder=4))

# Road and cars
ax.add_patch(Rectangle((0,0),16,.68,color="#3C4B55",zorder=5))
ax.plot([0,16],[.34,.34],color="#E8E4D8",lw=2,ls=(0,(1.4,2.5)),zorder=6)
cars=[]
for x,col in [(1.2,RED),(5.0,BLUE),(9.1,ORANGE),(13.0,GREEN)]:
    body=FancyBboxPatch((x,.22),1.15,.34,boxstyle="round,pad=0.04,rounding_size=0.08",
                        fc=col,ec="white",lw=.6,zorder=7)
    ax.add_patch(body)
    for wx in [x+.22,x+.82]:
        ax.add_patch(Circle((wx,.2),.11,fc="#172733",ec="#DDE7EB",lw=.5,zorder=8))
    cars.append(body)

# Factory with stacks
factory = Rectangle((.55,1.3),2.3,1.15,color="#536E7B",ec="#354F5B",lw=1.2,zorder=6)
ax.add_patch(factory)
ax.add_patch(Polygon([(.4,2.45),(1.0,2.8),(1.6,2.45),(2.2,2.8),(2.9,2.45)],color="#536E7B",zorder=6))
stack1=Rectangle((.9,2.45),.32,1.15,color="#455E6B",zorder=7)
stack2=Rectangle((1.65,2.45),.32,.85,color="#455E6B",zorder=7)
ax.add_patch(stack1); ax.add_patch(stack2)
ax.text(1.65,1.75,"INDUSTRY",ha="center",va="center",fontsize=10,color=WHITE,weight="bold",zorder=8)

# Dynamic smoke puffs
smoke_patches=[]
for i in range(18):
    p=Circle((1.05,3.7),.12+random.random()*.12,fc="#F3F5F5",ec="none",alpha=.0,zorder=8)
    ax.add_patch(p); smoke_patches.append((p,random.random(),random.random()))

# Haze overlays, drawn as large transparent ellipses
haze=[]
for x,y,w,h in [(3.5,4.8,6.5,2.4),(8.8,4.3,7.2,2.8),(5.5,3.2,8.0,1.8)]:
    e=matplotlib.patches.Ellipse((x,y),w,h,fc="#C58B59",ec="none",alpha=0,zorder=9)
    ax.add_patch(e); haze.append(e)

# HUD header and panels
ax.add_patch(FancyBboxPatch((.35,8.15),7.6,.52,boxstyle="round,pad=0.12,rounding_size=.12",
                            fc=NAVY,ec="none",alpha=.94,zorder=20))
title_artist=ax.text(.58,8.41,"PHOTOCHEMICAL SMOG FORMATION",ha="left",va="center",
                     color=WHITE,fontsize=17,weight="bold",zorder=21)
time_artist=ax.text(15.5,8.4,"00:00",ha="right",va="center",color=NAVY,fontsize=13,weight="bold",zorder=21)

caption_box=FancyBboxPatch((.45,6.9),7.7,.78,boxstyle="round,pad=.16,rounding_size=.12",
                           fc=NAVY,ec="#FFFFFF",lw=.8,alpha=.93,zorder=20)
ax.add_patch(caption_box)
caption=ax.text(.68,7.29,"",ha="left",va="center",color=WHITE,fontsize=14,weight="bold",zorder=21)
subcaption=ax.text(.68,7.03,"",ha="left",va="center",color="#D8E7F0",fontsize=10.2,zorder=21)

# Reaction card
rx_card=FancyBboxPatch((8.45,5.9),7.1,1.3,boxstyle="round,pad=.15,rounding_size=.12",
                       fc="#F8FBFC",ec="#D8E6EA",lw=1.2,alpha=.96,zorder=20)
ax.add_patch(rx_card)
rx_title=ax.text(8.75,6.88,"ATMOSPHERIC CHEMISTRY",ha="left",va="center",
                 fontsize=10,color=GREY,weight="bold",zorder=21)
rx1=ax.text(8.75,6.48,"",ha="left",va="center",fontsize=15,color=INK,weight="bold",zorder=21)
rx2=ax.text(8.75,6.12,"",ha="left",va="center",fontsize=12,color="#31556A",zorder=21)

# Particle collection: molecule-like labelled dots
particle_specs=[]
particle_artists=[]
for i in range(42):
    species=random.choice(["NO₂","VOC","O₂","NO","O₃"])
    x=random.uniform(2.6,15.2); y=random.uniform(3.1,6.2)
    color={"NO₂":RED,"VOC":PURPLE,"O₂":BLUE,"NO":ORANGE,"O₃":GREEN}[species]
    circ=Circle((x,y),.13,fc=color,ec="white",lw=.5,alpha=0,zorder=12)
    ax.add_patch(circ)
    txt=ax.text(x,y,species,ha="center",va="center",fontsize=6.2,color="white",weight="bold",alpha=0,zorder=13)
    particle_specs.append({"x":x,"y":y,"phase":random.random()*2*math.pi,"species":species,"color":color})
    particle_artists.append((circ,txt))

# Sunlight beams
beams=[]
for x in [11.2,12.0,12.8,13.6]:
    line,=ax.plot([13.8,x],[6.9,3.1],color="#FFF4A3",lw=2.2,alpha=0,zorder=10)
    beams.append(line)

# Reaction flow arrows
arrow = FancyArrowPatch((6.4,5.3),(8.1,5.3),arrowstyle="-|>",mutation_scale=16,
                        lw=2,color=WHITE,alpha=0,zorder=15)
ax.add_patch(arrow)
arrow_text=ax.text(7.25,5.55,"sunlight",ha="center",va="bottom",fontsize=9,color=NAVY,alpha=0,zorder=15)

# Stage data
def stage_for(t):
    if t < 5: return 0
    if t < 15: return 1
    if t < 27: return 2
    if t < 42: return 3
    if t < 53: return 4
    return 5

def init():
    return []

def update(frame):
    t=frame/FPS
    stage=stage_for(t)
    # Fade the sky into hazier conditions as the photochemical episode develops.
    haze_level=np.clip((t-30)/25,0,1)
    sky_color=np.array(matplotlib.colors.to_rgb(SKY_DAY))*(1-haze_level*.63)+np.array(matplotlib.colors.to_rgb(SKY_HAZE))*(haze_level*.63)
    sky.set_facecolor(sky_color)
    for e,scale in zip(haze,[.9,1.0,.8]):
        e.set_alpha(float(haze_level*.24*scale))
    # Sunlight rays and beams become prominent during photolysis.
    ray_alpha=.95 if 15 <= t < 42 else .48
    for ray in sun_rays: ray.set_alpha(ray_alpha)
    for b in beams:
        b.set_alpha(.72 if 15 <= t < 32 else (.25 if 32 <= t < 42 else 0))
    # emissions and plume
    for p,phase,speed in smoke_patches:
        x=1.05 + .24*math.sin(t*.65+phase) + (t*0.16+phase*1.8)%2.4
        y=3.1 + ((t*.32+phase)%1.0)*2.8
        p.center=(x,y)
        p.radius=.10+.13*((phase+t*.1)%1)
        p.set_alpha(.62 if t<15 else .22)
    # particles drift upward and sideways; labels become visible after emissions.
    visible = t >= 7
    for spec,(circ,txt) in zip(particle_specs,particle_artists):
        x=(spec["x"] + .12*t*math.sin(spec["phase"]+t*.35))%15.5
        y=spec["y"] + .18*math.sin(spec["phase"]+t*.7) + .025*t
        y=3.0+(y-3.0)%3.5
        circ.center=(x,y); txt.set_position((x,y))
        alpha=(.9 if visible else 0)
        if t>28: alpha*=.85
        circ.set_alpha(alpha); txt.set_alpha(alpha)
    # Equation cards and captions by stage
    if stage==0:
        caption.set_text("FROM EMISSIONS TO THE ATMOSPHERE")
        subcaption.set_text("Industrial stacks and vehicle exhaust release primary pollutants.")
        rx1.set_text("NOₓ  •  VOCs  •  CO")
        rx2.set_text("Primary pollutants enter the lower atmosphere.")
    elif stage==1:
        caption.set_text("1  |  EMISSION & DISPERSION")
        subcaption.set_text("Pollutants mix and move with the surrounding air.")
        rx1.set_text("NOₓ = NO + NO₂")
        rx2.set_text("VOCs are volatile organic compounds.")
    elif stage==2:
        caption.set_text("2  |  SUNLIGHT STARTS PHOTOCHEMISTRY")
        subcaption.set_text("Photons split nitrogen dioxide; the oxygen atom is highly reactive.")
        rx1.set_text("NO₂ + hν → NO + O(³P)")
        rx2.set_text("O(³P) + O₂ + M → O₃ + M")
    elif stage==3:
        caption.set_text("3  |  VOC OXIDATION HELPS BUILD OZONE")
        subcaption.set_text("Peroxy radicals convert NO to NO₂ without consuming ozone in that step.")
        rx1.set_text("RO₂• + NO → RO• + NO₂")
        rx2.set_text("HO₂• + NO → •OH + NO₂")
    elif stage==4:
        caption.set_text("4  |  SECONDARY POLLUTANTS ACCUMULATE")
        subcaption.set_text("Sunlight-driven chemistry produces a mixture—not just one compound.")
        rx1.set_text("O₃  •  PAN  •  ALDEHYDES")
        rx2.set_text("PAN forms through reactions of acyl-peroxy radicals with NO₂.")
    else:
        caption.set_text("PHOTOCHEMICAL SMOG")
        subcaption.set_text("A sunlight-driven mixture of ozone and other secondary pollutants.")
        rx1.set_text("NOₓ + VOCs + sunlight")
        rx2.set_text("Conditions, emissions, and air mixing affect smog intensity.")
    # Equation text and arrow emphasis
    arrow.set_alpha(.8 if 15<=t<42 else 0)
    arrow_text.set_alpha(.85 if 15<=t<42 else 0)
    # Traffic subtly moves
    for i,body in enumerate(cars):
        x0=[1.2,5.0,9.1,13.0][i]
        x=x0 + .25*math.sin(t*.5+i)
        body.set_x(x)
    time_artist.set_text(f"{int(t//60):02d}:{int(t%60):02d}")
    # Last-shot contrast: stronger warm haze and title.
    if t>=53:
        title_artist.set_color("#FFF3D1")
    else:
        title_artist.set_color(WHITE)
    return []

anim=FuncAnimation(fig, update, frames=TOTAL_FRAMES, init_func=init, interval=1000/FPS, blit=False)
writer=FFMpegWriter(fps=FPS, bitrate=5000, codec="libx264",
                    extra_args=["-pix_fmt","yuv420p","-movflags","+faststart"])
print(f"Rendering {DURATION}-second animation to {OUTFILE} ...")
anim.save(OUTFILE, writer=writer, dpi=100)
plt.close(fig)
print(f"Done: {os.path.abspath(OUTFILE)}")

